[Unit]
Description=serdabd - devices, rules and logs of the serdab tunnel
After=wg-quick@wg0.service
Requires=wg-quick@wg0.service
# wg-quick recreates wg0 (and drops its tc rules): restart with it so they come back
PartOf=wg-quick@wg0.service

[Service]
EnvironmentFile=/etc/serdab/serdabd.env
ExecStart=/usr/bin/python3 /usr/local/lib/serdab/serdabd.py serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target wg-quick@wg0.service
