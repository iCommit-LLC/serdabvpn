#!/usr/bin/env bash
# serdab - manage the devices of a serdabVPN server. Runs as root on the server.
# A device is one WireGuard peer: its own key pair, its own preshared key, its own /32.
set -euo pipefail

WG_DIR=/etc/wireguard
WG_IF=wg0
CLIENTS=/etc/wireguard/clients
WG_NET=10.7.0
DNS=${SERDAB_DNS:-1.1.1.1, 1.0.0.1}
MTU=${SERDAB_MTU:-1380}   # Google Cloud's network MTU is 1460; minus the WireGuard overhead

usage() {
  cat <<USAGE
serdab - your own tunnel.

  serdab add <device>    enrol a phone or laptop: prints the QR and the invitation link
  serdab link <device>   the invitation link again (send it in a chat; one tap sets the phone up)
  serdab qr <device>     the QR again (for a phone in the same room)
  serdab conf <device>   the config file (for a laptop, or the official WireGuard app)
  serdab rm <device>     revoke a device
  serdab list            devices, last handshake, traffic
USAGE
}

need_root() { [[ $EUID -eq 0 ]] || { echo "serdab: run as root (sudo serdab ...)" >&2; exit 1; }; }
valid_name() { [[ $1 =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || { echo "serdab: a device name is lowercase letters, digits and dashes" >&2; exit 1; }; }
exists() { [[ -e $CLIENTS/$1.conf ]] || { echo "serdab: no device called '$1' (serdab list)" >&2; exit 1; }; }

next_ip() {
  local used i
  used=$(grep -hoE "^Address = $WG_NET\.[0-9]+" "$CLIENTS"/*.conf 2>/dev/null | awk -F. '{print $4}' || true)
  for i in $(seq 2 254); do
    grep -qx "$i" <<<"$used" || { echo "$i"; return; }
  done
  echo "serdab: no free addresses left" >&2; exit 1
}

reload() {
  if wg show "$WG_IF" >/dev/null 2>&1; then
    wg syncconf "$WG_IF" <(wg-quick strip "$WG_IF")
  else
    systemctl start "wg-quick@$WG_IF" 2>/dev/null || wg-quick up "$WG_IF"
  fi
}

cmd_add() {
  need_root
  local name=${1:-}; [[ -n $name ]] || { usage; exit 1; }
  valid_name "$name"
  [[ -e $CLIENTS/$name.conf ]] && { echo "serdab: '$name' already exists (serdab qr $name)" >&2; exit 1; }
  umask 077
  local priv pub psk ip
  priv=$(wg genkey); pub=$(wg pubkey <<<"$priv"); psk=$(wg genpsk); ip=$WG_NET.$(next_ip)

  cat > "$CLIENTS/$name.conf" <<CONF
[Interface]
PrivateKey = $priv
Address = $ip/32
DNS = $DNS
MTU = $MTU

[Peer]
PublicKey = $(cat "$WG_DIR/server.pub")
PresharedKey = $psk
Endpoint = $(cat "$WG_DIR/endpoint")
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
CONF

  cat >> "$WG_DIR/$WG_IF.conf" <<CONF

# serdab:$name
[Peer]
PublicKey = $pub
PresharedKey = $psk
AllowedIPs = $ip/32
CONF

  reload
  echo "enrolled '$name' at $ip"
  echo
  echo "In the same room: scan this with the serdabVPN app (the official WireGuard app works too)."
  echo
  cmd_qr "$name"
  echo
  echo "Far away: send this link in a chat. In the app they tap 'I was sent an invitation'."
  echo "It holds the private key: send it to that one person, then delete the message."
  echo
  cmd_link "$name"
}

# serdab://add?c=<base64url(config)>&n=<device>   (the app's lib/invite.dart reads it)
cmd_link() {
  local name=${1:-}; [[ -n $name ]] || { usage; exit 1; }
  exists "$name"
  local c
  c=$(base64 -w0 < "$CLIENTS/$name.conf" | tr '+/' '-_' | tr -d '=')
  echo "serdab://add?c=$c&n=$name"
}

cmd_qr() {
  local name=${1:-}; [[ -n $name ]] || { usage; exit 1; }
  exists "$name"
  qrencode -t ansiutf8 < "$CLIENTS/$name.conf"
}

cmd_conf() {
  local name=${1:-}; [[ -n $name ]] || { usage; exit 1; }
  exists "$name"
  cat "$CLIENTS/$name.conf"
}

cmd_rm() {
  need_root
  local name=${1:-}; [[ -n $name ]] || { usage; exit 1; }
  valid_name "$name"
  exists "$name"
  # drop the block from its "# serdab:<name>" marker to the next blank line
  awk -v m="# serdab:$name" '$0==m{skip=1} skip&&NF==0{skip=0; next} !skip' "$WG_DIR/$WG_IF.conf" > "$WG_DIR/$WG_IF.conf.tmp"
  mv "$WG_DIR/$WG_IF.conf.tmp" "$WG_DIR/$WG_IF.conf"
  rm -f "/etc/wireguard/clients/${name:?}.conf"
  reload
  echo "revoked '$name'"
}

human() { numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1"; }
ago() {
  local s=$(( $(date +%s) - $1 ))
  if (( s < 60 )); then echo "${s}s ago"; elif (( s < 3600 )); then echo "$((s/60))m ago"
  elif (( s < 86400 )); then echo "$((s/3600))h ago"; else echo "$((s/86400))d ago"; fi
}

cmd_list() {
  local dump f name priv pub line hs rx tx ip
  dump=$(wg show "$WG_IF" dump 2>/dev/null | tail -n +2 || true)
  printf "%-16s %-14s %-12s %-10s %-10s\n" DEVICE ADDRESS HANDSHAKE DOWN UP
  for f in "$CLIENTS"/*.conf; do
    [[ -e $f ]] || { echo "(no devices yet - serdab add <device>)"; return; }
    name=$(basename "$f" .conf)
    priv=$(awk -F' = ' '/^PrivateKey/{print $2}' "$f"); pub=$(wg pubkey <<<"$priv")
    ip=$(awk -F' = ' '/^Address/{print $2}' "$f")
    line=$(grep -F "$pub" <<<"$dump" || true)
    if [[ -n $line ]]; then
      hs=$(cut -f5 <<<"$line"); rx=$(cut -f6 <<<"$line"); tx=$(cut -f7 <<<"$line")
      printf "%-16s %-14s %-12s %-10s %-10s\n" "$name" "$ip" "$([[ $hs == 0 ]] && echo never || ago "$hs")" "$(human "$tx")" "$(human "$rx")"
    else
      printf "%-16s %-14s %-12s\n" "$name" "$ip" "(server down)"
    fi
  done
}

case ${1:-} in
  add)  cmd_add "${2:-}" ;;
  link) cmd_link "${2:-}" ;;
  qr)   cmd_qr "${2:-}" ;;
  conf) cmd_conf "${2:-}" ;;
  rm)   cmd_rm "${2:-}" ;;
  list|ls) cmd_list ;;
  *) usage; exit 1 ;;
esac
